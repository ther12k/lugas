{
  "name": "lugas",
  "private": true,
  "version": "0.0.0",
  "description": "LugasJS — small, explicit, Bun-native TypeScript framework (pre-release workspace)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/browser": {
      "default": "./build/lugas-client.esm.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "bin": {
    "lugas": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "build",
    "README.md",
    "NOTICE",
    "AGENTS.md",
    "docs/okf/architecture"
  ],
  "scripts": {
    "versions": "bun --version && tsc --version",
    "build:dist": "bun run scripts/release/build-dist.ts",
    "build:browser-client": "bun run scripts/release/build-browser-client.ts",
    "build": "bun run build:dist && bun run build:browser-client",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:docs": "bun run scripts/verify-okf.ts",
    "verify": "bun run scripts/verify.ts",
    "release:package:rehearse": "bun run scripts/release/package-beta.ts",
    "verify:compatibility-report": "bun run scripts/verify-compatibility-report.ts"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/bun": "1.4.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "2.0.0-beta.6",
    "typescript": "7.0.2",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "license": "Apache-2.0"
}
