# Worktrees (one per issue; never commit them)
.worktrees/

# Dependencies and lock-adjacent state
node_modules/

# Build output and coverage
dist/
build/
coverage/
*.tsbuildinfo

# Raw benchmark artifacts (results are reported, not committed raw)
benchmarks/**/*.local.json
benchmarks/**/results/

# Secrets and local environment
.env
.env.*
*.pem
*.key

# Editor and OS debris
.DS_Store
Thumbs.db

# (M6R3) The exact release tarball is NO LONGER ignored: publication bytes
# must be committed and covered by docs/releases/beta/SHA256SUMS so a clean
# checkout can attest them. Regenerated by bun run release:package:rehearse.
