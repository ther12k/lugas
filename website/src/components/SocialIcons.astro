---
import Default from '@astrojs/starlight/components/SocialIcons.astro';

// Header-right navigation (splash-landing redesign): the three primary doc
// destinations as plain text links, followed by Starlight's default social
// icons (GitHub). Links include the site base path.
const links = [
  { href: '/lugas/getting-started/', label: 'Docs' },
  { href: '/lugas/examples/', label: 'Examples' },
  { href: '/lugas/api-reference/', label: 'API' },
];
---

<nav class="header-links" aria-label="Primary">
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</nav>
<Default />

<style>
  .header-links {
    display: flex;
    gap: 1.25rem;
    margin-inline-end: 0.75rem;
  }
  .header-links a {
    color: var(--sl-color-text);
    font-size: 0.875rem;
    text-decoration: none;
    opacity: 0.85;
  }
  .header-links a:hover,
  .header-links a:focus-visible {
    opacity: 1;
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 50rem) {
    /* Small screens: the mobile sidebar covers navigation; keep the header lean. */
    .header-links {
      display: none;
    }
  }
</style>
